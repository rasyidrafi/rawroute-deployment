# Public hostname pointing at this server; ports 80/443 must be reachable.
RAWROUTE_HOST=gateway.example.com
# For a parallel HTTP deployment instead of the default HTTPS setup:
# RAWROUTE_SITE=:80
# RAWROUTE_HTTP_PORT=8081
# RAWROUTE_HTTPS_PORT=8443
# RAWROUTE_PUBLIC_URL=http://server.example.com:8081
